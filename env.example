# AgentHub Platform - Environment Configuration
# Copie este arquivo para .env e configure as variáveis

# =============================================
# FRONTEND CONFIGURATION
# =============================================
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_APP_NAME=AgentHub
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================
# BACKEND SERVICES CONFIGURATION
# =============================================

# Auth Service
AUTH_SERVICE_URL=http://localhost:8001
SECRET_KEY=your-secret-key-change-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URLs
AUTH_DATABASE_URL=postgresql://agenthub:agenthub_password@localhost:5432/auth_service
AGENT_DATABASE_URL=postgresql://agenthub:agenthub_password@localhost:5433/agent_orchestrator
DOCUMENT_DATABASE_URL=postgresql://agenthub:agenthub_password@localhost:5434/document_service
BILLING_DATABASE_URL=postgresql://agenthub:agenthub_password@localhost:5435/billing_service

# Agent Orchestrator
AGENT_ORCHESTRATOR_URL=http://localhost:8002
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=500
GEMINI_TEMPERATURE=0.7

# Document Service
DOCUMENT_SERVICE_URL=http://localhost:8003
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# Billing Service
BILLING_SERVICE_URL=http://localhost:8004
DEFAULT_TOKEN_BALANCE=1000
TOKEN_PURCHASE_RATE=1.0

# =============================================
# EXTERNAL SERVICES
# =============================================

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# OCR Configuration
TESSERACT_CMD=tesseract
TESSERACT_LANG=por

# =============================================
# SECURITY CONFIGURATION
# =============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================
# MONITORING & LOGGING
# =============================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
HEALTH_CHECK_INTERVAL=30

# =============================================
# DEVELOPMENT CONFIGURATION
# =============================================
NODE_ENV=development
DEBUG=true
HOT_RELOAD=true

# =============================================
# PRODUCTION OVERRIDES (uncomment for production)
# =============================================
# NODE_ENV=production
# DEBUG=false
# CORS_ORIGINS=https://yourdomain.com
# SECRET_KEY=your-production-secret-key
# GEMINI_API_KEY=your-production-gemini-key

